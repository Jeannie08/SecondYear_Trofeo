
public class HomeMDA {
    public static void main(String[] args) {
        FamilyChoresMDA chores = new FamilyChoresMDA();
        chores.displayChores();
    }
}

public class FamilyChoresMDA {
    String[] members = {"Mama", "Papa", "Jee", "Bee"};
    String[][] chores = {
        {"Cooking", "Laundry", "Grocery Shopping"},
        {"Gardening", "Fixing", "Driving"},
        {"Cleaning", "Homework", "Watering Plants"},
        {"Dishes", "Trash", "Sweeping"}
    };

    public void displayChores() {
        System.out.println("Family Chores Schedule:");
        for (int i = 0; i < members.length; i++) {
            System.out.print(members[i] + ": ");
            for (int j = 0; j < chores[i].length; j++) {
                System.out.print(chores[i][j] + " ");
            }
            System.out.println();
        }
    }
}

